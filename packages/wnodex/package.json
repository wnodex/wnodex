{
  "name": "wnodex",
  "version": "0.3.0",
  "private": false,
  "description": "An extensible and robust Express.js server framework designed for effortless customization and rapid deployment with sensible defaults.",
  "keywords": [
    "wnodex",
    "express",
    "framework",
    "typescript",
    "nodejs",
    "server",
    "http",
    "web",
    "security",
    "middleware"
  ],
  "homepage": "https://github.com/wnodex/wnodex#readme",
  "bugs": {
    "url": "https://github.com/wnodex/wnodex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wnodex/wnodex.git",
    "directory": "packages/wnodex"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rolldown -c && tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@wnodex/body-parser": "workspace:*",
    "@wnodex/compression": "workspace:*",
    "@wnodex/cookie-parser": "workspace:*",
    "@wnodex/cors": "workspace:*",
    "@wnodex/errors": "workspace:*",
    "@wnodex/helmet": "workspace:*",
    "@wnodex/hpp": "workspace:*",
    "@wnodex/logger": "workspace:*",
    "@wnodex/passport": "workspace:*",
    "@wnodex/rate-limit": "workspace:*",
    "@wnodex/session": "workspace:*",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "passport": "^0.7.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dcdavidev/tsconfig": "^0.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/hpp": "^0.2.7",
    "@types/node": "^25.5.0",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^7.2.0",
    "rolldown": "1.0.0-rc.9",
    "supertest": "^7.2.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
