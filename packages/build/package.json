{
  "name": "@wnodex/build",
  "version": "0.4.0",
  "private": false,
  "description": "Unified build scripts and utilities for the wnodex ecosystem.",
  "keywords": [
    "wnodex",
    "build",
    "esbuild",
    "sync"
  ],
  "homepage": "https://github.com/wnodex/wnodex#readme",
  "bugs": {
    "url": "https://github.com/wnodex/wnodex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wnodex/wnodex.git",
    "directory": "packages/build"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wnodex-build": "./dist/bin.js"
  },
  "scripts": {
    "build": "rolldown -c && tsc"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "sync-directory": "^6.0.4"
  },
  "devDependencies": {
    "@dcdavidev/tsconfig": "^0.1.0",
    "@types/node": "^25.5.0",
    "rolldown": "1.0.0-rc.9",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
