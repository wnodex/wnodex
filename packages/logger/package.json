    "wnodex",
    "logger",
    "pino",
    "pino-pretty",
    "logging",
    "json-logger"
  ],
  "homepage": "https://github.com/wnodex/wnodex#readme",
  "bugs": {
    "url": "https://github.com/wnodex/wnodex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wnodex/wnodex.git",
    "directory": "packages/logger"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
